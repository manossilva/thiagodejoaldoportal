# Copie este arquivo para .env (uso local com `vercel dev`) e/ou configure
# estas mesmas variáveis no painel da Vercel: Project Settings > Environment Variables.
# A SUPABASE_ANON_KEY é pública por natureza — quem protege os dados é o RLS do schema.sql.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Opcional — só preencha quando quiser ligar o reCAPTCHA no login do painel.
# Deixando em branco (ou sem configurar na Vercel), o site funciona normalmente
# e o reCAPTCHA simplesmente não aparece. Veja o passo 4 do README.md.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
